<Window x:Class="VibecoreHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vibecore Hub" Width="250" Height="58" MinWidth="250" MinHeight="58"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BarBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6,0,6,0" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Border CornerRadius="14" BorderThickness="0" Background="{DynamicResource BarBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="TopBar" Grid.Row="0" Margin="3,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
        <Grid x:Name="LogoArea" Grid.Column="0" Background="Transparent" ToolTip="拖动移动 · 右键设置" PreviewMouseRightButtonDown="LogoArea_MouseRightButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><RotateTransform Angle="45" /></Grid.RenderTransform>
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" Opacity="0.42" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" Opacity="0.42" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
        <StackPanel x:Name="ModuleButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="PinButton" Grid.Column="0" Style="{StaticResource TopChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="28" Height="36" Foreground="{DynamicResource MutedBrush}" Click="Pin_Click">
            <TextBlock x:Name="PinIcon" FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE718;" />
          </Button>
          <Button Grid.Column="1" Style="{StaticResource TopChromeButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="28" Height="36" Foreground="{DynamicResource MutedBrush}" ToolTip="隐藏到托盘" Click="Hide_Click">
            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE711;" />
          </Button>
        </Grid>
      </Grid>
      <ScrollViewer x:Name="ModuleScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel x:Name="ModuleStack" />
      </ScrollViewer>
      <Border x:Name="FloatingResizeGrip" Grid.Row="1" Panel.ZIndex="20" Height="16" VerticalAlignment="Bottom"
              Background="{DynamicResource BarBrush}" Cursor="SizeNS" Visibility="Collapsed"
              MouseLeftButtonDown="FloatingGrip_MouseLeftButtonDown" MouseMove="FloatingGrip_MouseMove" MouseLeftButtonUp="FloatingGrip_MouseLeftButtonUp"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid>
          <Rectangle Width="38" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentBrush}" Opacity="0.85"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
