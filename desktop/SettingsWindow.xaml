<Window x:Class="VibecoreHub.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vibecore Hub 设置" Width="420" Height="620" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border CornerRadius="14" BorderThickness="0" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="92"/><RowDefinition Height="78"/><RowDefinition Height="210"/><RowDefinition Height="105"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock Text="Vibecore Hub 设置" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button>
      </Grid>
      <StackPanel Grid.Row="1">
        <TextBlock Text="电脑配置" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ProfileBox" Height="38" DisplayMemberPath="Name"/>
          <Button Grid.Column="1" Height="38" Margin="9,0,0,0" Content="新建" Click="NewProfile_Click"/>
          <Button Grid.Column="2" Height="38" Margin="7,0,0,0" Content="改名" Click="RenameProfile_Click"/>
        </Grid>
        <TextBlock Text="每套配置分别保存快捷方式、目录、笔记、音频和窗口布局" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="1,7,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="2">
        <TextBlock Text="主题" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
        <ComboBox x:Name="ThemeBox" Height="38" FontSize="12"><ComboBoxItem Tag="midnight">午夜</ComboBoxItem><ComboBoxItem Tag="porcelain">瓷白</ComboBoxItem><ComboBoxItem Tag="aurora">极光</ComboBoxItem><ComboBoxItem Tag="blush">雾粉</ComboBoxItem></ComboBox>
      </StackPanel>
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="顶部功能顺序" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <ListBox x:Name="ModuleList" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" FontSize="12" Padding="5" DisplayMemberPath="Title"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button Width="36" Height="36" Margin="0,0,0,8" Content="↑" Click="MoveUp_Click"/><Button Width="36" Height="36" Content="↓" Click="MoveDown_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,12,0,0">
        <TextBlock Text="数据备份" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9"/>
        <StackPanel Orientation="Horizontal">
          <Button Width="112" Height="36" Margin="0,0,10,0" Content="备份到文件" Click="Backup_Click"/>
          <Button Width="112" Height="36" Content="从备份恢复" Click="Restore_Click"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Width="72" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click"/>
        <Button Width="72" Height="34" Content="保存" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
