<Window x:Class="VibecoreHub.Desktop.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建电脑配置" Width="380" Height="245" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border CornerRadius="14" Padding="22" Background="{DynamicResource RaisedBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock x:Name="Heading" Text="新建电脑配置" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,7,0,0">
        <TextBlock Text="配置名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,7"/>
        <TextBox x:Name="NameBox" Height="38" VerticalContentAlignment="Center" Text="新电脑"/>
        <CheckBox x:Name="CopyBox" Content="复制当前配置作为起点" IsChecked="True" Margin="2,16,0,0" Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Width="72" Height="36" Margin="0,0,8,0" Content="取消" Click="Cancel_Click"/>
        <Button Width="72" Height="36" Content="创建" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
