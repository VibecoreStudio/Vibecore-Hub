<UserControl x:Class="VibecoreHub.Desktop.Modules.Search.GlobalSearchModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="13,11,13,6">
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
      <Grid><TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource FaintBrush}" Text="&#xE721;"/>
        <TextBox x:Name="SearchBox" Margin="34,0,9,0" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource AccentBrush}" TextChanged="SearchBox_TextChanged"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <ItemsControl x:Name="ResultsList">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button Height="47" Margin="0,0,0,5" Padding="11,0" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="Result_Click" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Cursor="Hand">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource AccentBrush}" Text="{Binding Glyph}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource FaintBrush}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="HintText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource FaintBrush}" Text="搜索快捷方式和便笺"/>
  </Grid>
</UserControl>
