<Window x:Class="VibecoreHub.Desktop.Modules.Notes.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置便笺" Width="380" Height="390" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border BorderThickness="0" CornerRadius="14" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock Text="设置便笺" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button>
      </Grid>
      <StackPanel Grid.Row="1">
        <TextBlock Text="标题" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,6"/>
        <TextBox x:Name="TitleBox" Height="34" Padding="9,0" VerticalContentAlignment="Center" FontSize="12"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Text="文字内容" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
        <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" Padding="10" FontSize="13" VerticalAlignment="Stretch" MinHeight="190"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Width="72" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click"/>
        <Button Width="72" Height="34" Content="保存" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
