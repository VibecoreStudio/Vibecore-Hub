<Window x:Class="VibecoreHub.Desktop.Modules.Folders.FolderDirectoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="255" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}">
  <Border CornerRadius="14" BorderThickness="0" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown"><TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button></Grid>
      <StackPanel Grid.Row="1"><TextBlock Text="显示名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="NameBox" Height="34" Padding="9,0" VerticalContentAlignment="Center"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="文件夹路径" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" Height="34" Padding="9,0" VerticalContentAlignment="Center"/><Button Grid.Column="1" Margin="8,0,0,0" Content="浏览" Click="Browse_Click"/></Grid></StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Width="70" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click"/><Button Width="70" Height="34" Content="保存" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Click="Save_Click"/></StackPanel>
    </Grid>
  </Border>
</Window>
