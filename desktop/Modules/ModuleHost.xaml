<UserControl x:Class="VibecoreHub.Desktop.Modules.ModuleHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="{DynamicResource PanelBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="12"/>
    </Grid.RowDefinitions>
    <ContentPresenter x:Name="ModuleContent" Grid.Row="0"/>
    <Border x:Name="ResizeGrip" Grid.Row="1" Cursor="SizeNS" Background="Transparent"
            MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown">
      <TextBlock Text="•••" FontSize="10" Foreground="{DynamicResource FaintBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</UserControl>
