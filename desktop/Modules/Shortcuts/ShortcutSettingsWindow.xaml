<Window x:Class="VibecoreHub.Desktop.Modules.Shortcuts.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷方式设置" Width="380" Height="405" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border CornerRadius="14" BorderThickness="0" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock Text="快捷方式设置" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,4,0,0">
        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="图标大小："/><Run x:Name="IconSizeValue"/></TextBlock>
        <Slider x:Name="IconSizeSlider" Minimum="30" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,7,0,16" ValueChanged="IconSizeSlider_ValueChanged"/>
        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="每行图标："/><Run x:Name="ColumnsValue"/></TextBlock>
        <Slider x:Name="ColumnsSlider" Minimum="2" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,7,0,16" ValueChanged="ColumnsSlider_ValueChanged"/>
        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="图标间距："/><Run x:Name="GapValue"/></TextBlock>
        <Slider x:Name="GapSlider" Minimum="0" Maximum="24" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,7,0,16" ValueChanged="GapSlider_ValueChanged"/>
        <TextBlock Text="收纳文件夹打开方式" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
        <ComboBox x:Name="GroupOpenModeBox" Height="34">
          <ComboBoxItem Tag="single" Content="单窗口（打开新的时关闭上一个）"/>
          <ComboBoxItem Tag="multiple" Content="多窗口（每个收纳文件夹各开一个）"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Width="72" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click"/>
        <Button Width="72" Height="34" Content="保存" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
