<Window x:Class="VibecoreHub.Desktop.Modules.Shortcuts.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷项" Width="360" Height="390" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Border BorderThickness="0" CornerRadius="14" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Top" />
        <Button HorizontalAlignment="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Cancel_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" /></Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,6" />
        <ComboBox x:Name="TypeBox" Height="36" FontSize="12" SelectionChanged="TypeBox_SelectionChanged">
          <ComboBoxItem Tag="application">应用程序</ComboBoxItem><ComboBoxItem Tag="file">单个文件</ComboBoxItem><ComboBoxItem Tag="group">收纳文件夹</ComboBoxItem><ComboBoxItem Tag="text">单个文本</ComboBoxItem><ComboBoxItem Tag="folder">文件夹</ComboBoxItem>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Text="显示名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,6" />
        <TextBox x:Name="NameBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12" />
      </StackPanel>
      <StackPanel x:Name="TargetPanel" Grid.Row="3" Margin="0,14,0,0">
        <TextBlock x:Name="TargetLabel" Text="路径" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TargetBox" MinHeight="70" Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12" />
          <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Height="36" VerticalAlignment="Top" Content="浏览" FontSize="12" Click="Browse_Click" />
        </Grid>
      </StackPanel>
      <Grid Grid.Row="4" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="70" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click" />
          <Button Width="70" Height="34" Content="保存" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
