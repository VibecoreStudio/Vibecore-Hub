<Window x:Class="VibecoreHub.Desktop.Modules.Shortcuts.ShortcutGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="330" Height="350" MinWidth="250" MinHeight="180" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="Manual" Background="{DynamicResource PanelBrush}"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border CornerRadius="14" BorderThickness="0" Background="{DynamicResource PanelBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="14,0,8,0">
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
        <Button HorizontalAlignment="Right" Width="30" Height="30" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Close_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;"/></Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="10,6,10,10" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel x:Name="ItemsPanel" AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
